{
	"name": "harness-boilerplate",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "node --watch src/server.ts",
		"start": "node src/server.ts",
		"app": "node tools/app-cli.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"knip": "knip",
		"loc": "node tools/loc-report.ts",
		"docs:check-temporal": "node tools/check-docs-temporal.ts",
		"docs:check-decisions": "node tools/check-decisions.ts",
		"docs:check-links": "node tools/check-doc-links.ts",
		"skills:check": "node tools/check-skills.ts",
		"primitives:check": "node tools/classify-primitives.ts --check",
		"features:check": "node tools/app-cli.ts map --check",
		"slop-ratchet:check": "node tools/check-file-size-ratchet.ts && node tools/check-decorative-banners.ts",
		"validate": "concurrently -g -n format,lint,types,test,knip,temporal,decisions,links,mermaid,skills,primitives,features,slop,audit \"npm:format:check\" \"npm:lint\" \"npm:typecheck\" \"npm:test\" \"npm:knip\" \"npm:docs:check-temporal\" \"npm:docs:check-decisions\" \"npm:docs:check-links\" \"npm:docs:check-mermaid\" \"npm:skills:check\" \"npm:primitives:check\" \"npm:features:check\" \"npm:slop-ratchet:check\" \"npm:audit:prod\"",
		"validate:fix": "npm run format && npm run lint:fix",
		"prepare": "husky",
		"docs:check-mermaid": "node tools/check-mermaid.ts",
		"audit:prod": "npm audit --omit=dev --audit-level=moderate"
	},
	"lint-staged": {
		"*.{ts,js,mjs}": [
			"oxlint --fix",
			"prettier --write"
		],
		"*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@types/node": "^22.18.0",
		"concurrently": "^9.2.0",
		"husky": "^9.1.7",
		"knip": "^5.62.0",
		"lint-staged": "^16.1.0",
		"mermaid": "^11.17.2",
		"oxlint": "^1.14.0",
		"prettier": "^3.6.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0",
		"yaml": "^2.8.0"
	}
}
