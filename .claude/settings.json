{
	"permissions": {
		"allow": [
			"Bash(npm run validate)",
			"Bash(npm run validate:fix)",
			"Bash(npm run lint)",
			"Bash(npm run typecheck)",
			"Bash(npm run test)",
			"Bash(node bin/harness.ts *)",
			"Bash(npx vitest run *)",
			"Bash(git diff *)",
			"Bash(git status)",
			"Bash(git log *)",
			"Bash(gh pr view *)",
			"Bash(gh pr checks *)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/bin/harness.ts\" hook guard-bash"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/bin/harness.ts\" hook typecheck"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/bin/harness.ts\" hook validate-on-stop",
						"timeout": 300
					}
				]
			}
		]
	}
}
